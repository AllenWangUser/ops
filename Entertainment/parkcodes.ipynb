# This code saves a file of all the major theme parks and their
# ID codes in a file called theme_park_directory.txt in the 
# working directory of the script. It pulls the code using the
# api link from api.themeparks.wiki.
# Also sorts destination and park names alphabetically for easier
# reading and referencing.


# Load libraries
import requests
import os
import sys

# Find the working directory and find existing "data" folder
# and creates the file path for the target save location.
target_dir = os.path.join(os.getcwd(), "data/final")
os.makedirs(target_dir, exist_ok=True)
file_path = os.path.join(target_dir, "theme_park_directory_final.txt")

# API link where the themepark codes are sourced.
url = "https://api.themeparks.wiki/v1/destinations"
apicheck = requests.get(url)

# Checks API for OK status code (200)
if apicheck.status_code == 200:
   if 'application/json' in apicheck.headers.get('Content-Type', ''):
      data = apicheck.json()
      print("API connection live.")

      # Sort the destinations list by the 'name' key
      sorted_destinations = sorted(data['destinations'], key=lambda x: x['name'])

# Open the text file to write using 'w' and print out title
      with open(file_path, 'w', encoding='utf-8') as file:
           file.write("Theme Park Directory Codes\n")
           file.write("*" * 60 + "\n")
            
# Loop and print out the destination, destination ID, and different parks information
# for all parks
           for dest in sorted_destinations:
                  file.write(f"Destination: {dest['name']}\n")
                  file.write(f"Destination ID: {dest['id']}\n")
                  
                  # Optional: Sort the parks within each destination too
                  sorted_parks = sorted(dest.get('parks', []), key=lambda x: x['name'])
           
                  for park in sorted_parks:
                     file.write(f"  -> Park: {park['name']} | Park ID: {park['id']}\n")
                  file.write("-" * 50 + "\n")
                    
# Print out confirmation message to know that loop has been closed
# and file has been processed.
      print(f"Success. The file has been completed and can be found at this directory:\n{file_path}")
   else:
      print("Server returned 200, but the file could not be processed.")

# The following statuses to check are 
# 1xx: Informational
# 2xx: Success
# 3xx: Redirection
# 4xx: Client Errors
# 5xx: Server Errors
else:
   print(f"Failed to pull data. Status code: {apicheck.status_code}")

# Exit the script	
sys.exit()