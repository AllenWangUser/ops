# This code uses an API key to pull weather data from
# Anaheim, CA from home.openweathermap.org. Feel free
# to replace the api_key with your own key or the city
# with a different city name.

#Load Libraries
import requests
import csv
import os
import time
from datetime import datetime

# Set up the API connection and get ready to pull data.
api_key = "51903ef7b0d0f741669ac13a9f7f9def"  ## Replace this value with your own key
city = "Anaheim"
csv_filename = os.path.join(os.getcwd(), "data/final", "weather_data_final.csv")

# Check if the current directory exists and create
# the directory if the filepath does not exist.
os.makedirs(os.path.dirname(csv_filename), exist_ok=True)

# Uses a dynamic field in the URL to pull the exact data required
# for this project.
def log_weather():
    url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={api_key}&units=imperial"

# Perform a timeout feature if the API times out
# so that the script does not get stuck in an infinite loop.
    try:
        response = requests.get(url, timeout=10)
        if response.status_code == 200:
            data = response.json()
            print("Server response received")
            
# Pull the weather data that includes the temperature,
# weather and the weather description and timestamp it.
            temp = data['main']['temp']
            desc = data['weather'][0]['description']
            timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            
# Save and append to current file with the same name
# Use semicolon as deliminator.
            file_exists = os.path.isfile(csv_filename)
            with open(csv_filename, 'a', newline='', encoding='utf-8') as file:
                writer = csv.writer(file, delimiter=';')
                if not file_exists:
                    writer.writerow(["Timestamp", "Location", "Temperature", "Condition"])
                writer.writerow([timestamp, city, temp, desc])

# Print the output results in the terminal or
# return an error and status code if there is an error.
            print(f"[{timestamp}] SUCCESS: Logged {temp}°F, {desc}")
        else:
            print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] ERROR: API returned status {response.status_code}")

# Return the general error.
    except Exception as e:
        print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] ERROR: {e}")

# Description of the output.
print(f"Logging weather details for {city} every 60 minutes")

while True:
    log_weather()
	
# Timer in seconds, 3600 seconds = 1 hour
    time.sleep(3600)