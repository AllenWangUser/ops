# This code uses an API key to pull weather data from
# various cities in Southern California from 
# home.openweathermap.org. Feel free
# to replace the api_key with your own key or the city
# with a different city name.

# Load Libraries
import requests
import csv
import os
import time
from datetime import datetime

# Set up the API connection and get ready to pull data.
# Must add your own API key
api_key = "[INPUT API KEY HERE]"  ## Replace this value with your own key
cities = ["Anaheim", "Buena Park", "Hollywood", "San Diego", "Valencia"] 
csv_filename = os.path.join(os.getcwd(), "data/final", "weather_data_final.csv")

# Check the directory exists and
# create the directory if it doesn't exist
os.makedirs(os.path.dirname(csv_filename), exist_ok=True)

# Definition for the function that 
# pulls the data together with the 
# cities and save to a CSV file.
def log_weather():

# This loop will go the list of cities
    for city in cities:
        url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={api_key}&units=imperial"

# Prevents the script from hanging
        try:
            response = requests.get(url, timeout=10)
            if response.status_code == 200:
                data = response.json()

# Updates with the individual temperature
# and weather description for each city.
                temp = data['main']['temp']
                desc = data['weather'][0]['description']
                timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

# Checks if the file exists and writes the
# header if it doesn't.
                file_exists = os.path.isfile(csv_filename)

# Writes the data to the CSV file 
# and appending the new data if it already exists.
                with open(csv_filename, 'a', newline='', encoding='utf-8') as file:
                    writer = csv.writer(file, delimiter=';')
                    if not file_exists:
                        # Your city column is right here under "Location"
                        writer.writerow(["Timestamp", "Location", "Temperature", "Condition"])
                    writer.writerow([timestamp, city, temp, desc])

# Prints out the status of the API call
# and the results that will be printed out
# to the CSV file. If the API call fails, 
# it will print out an error message with
# the status code.
                print(f"[{timestamp}] SUCCESS: Logged {city} at {temp}°F, {desc}")
            else:
                print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] ERROR for {city}: API status {response.status_code}")

        except Exception as e:
            print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] ERROR for {city}: {e}")
        
# A quick system pause to allow the API
# to respond and not overflood the server
# with requests.
        time.sleep(1)

print(f"Logging weather details for {len(cities)} cities every 60 minutes...")

# The sleep loop that will keep the
# program running and logging the 
# weather data every 60 minutes.
while True:
    log_weather()
    time.sleep(3600)