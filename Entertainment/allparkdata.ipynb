# This script pulls data for Any park Park from
# thrill-data.com and saves it to their own
# park individual CSV file.
# This pulls data on a 15 minute interval and appends
# the new data to the the new file.

# Import Libraries
import requests
import csv
import os
import time
from datetime import datetime

# Here is the settings to add the parks to run
# data collection for. Be sure to use park id
# and not the resort ID.
# Add as many parks as you want to this dictionary.
# Format: "file_prefix": "park_id"
PARKS = {
    "dca": "832fcd51-ea19-4e77-85c7-75d5843b127c", # Disney California Adventure
    "dlr": "7340550b-c14d-4def-80bb-acdb51d49a66", # Disneyland Park
    # "[prk]": "[insert park ID here]"  # Example: "ATR" : "0d8ea921-37b1-4a9a-b8ef-5b45afea847b" (uncomment to test)
}

# Ensure the save directory exists
# Make the directory if the save file does not exist.
save_dir = os.path.join(os.getcwd(), "data/final")
os.makedirs(save_dir, exist_ok=True)

# Run the pipeline function that will
# check for current system time
# check the API for each park and save
# the data to the corresponding park.
def run_pipeline():
    current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    print(f"\n[{current_time}] Waking up and checking API for {len(PARKS)} parks.")

# Loop through every park in your configuration
    for park_prefix, park_id in PARKS.items():
        url = f"https://api.themeparks.wiki/v1/entity/{park_id}/live"
        csv_filename = os.path.join(save_dir, f"{park_prefix}_wait_times_final.csv")

# Timeout on the response to prevent the script
# from hanging if the API is unresponsive.
# It will just skip to the next park.
        try:
            response = requests.get(url, timeout=10)

# Statues code 200 = OK
            if response.status_code == 200:
                data = response.json()
                valid_data_to_save = []

# Parse the live ride data
                for ride in data.get('liveData', []):
                    name = ride.get('name', 'Unknown')
                    status = ride.get('status', 'UNKNOWN')

# Only save data if the ride is 
# operating and has standby wait time data.
                    if status == "OPERATING" and ride.get('queue') and ride['queue'].get('STANDBY'):
                        minutes = ride['queue']['STANDBY'].get('waitTime')
                        if minutes is not None:
                            valid_data_to_save.append([current_time, name, minutes])

# Check if data was found and write to the 
# specific park's CSV
                if len(valid_data_to_save) == 0:
                    print(f"[{current_time}] [{park_prefix.upper()}] CRITICAL: Park closed or no standby data.")
                else:
                    file_exists = os.path.isfile(csv_filename)
                    with open(csv_filename, 'a', newline='', encoding='utf-8') as file:
                        writer = csv.writer(file, delimiter=';')
                        if not file_exists:
                            writer.writerow(["Timestamp", "Ride Name", "Wait Time (Minutes)"])
                        writer.writerows(valid_data_to_save)

# Print out results to check on current
# data processing and if the data is being saved.
                    print(f"[{current_time}] [{park_prefix.upper()}] Appended {len(valid_data_to_save)} records to {park_prefix}_wait_times_final.csv")
            else:
                print(f"[{current_time}] [{park_prefix.upper()}] Connection failed: Status {response.status_code}")

        except requests.exceptions.Timeout:
            print(f"[{current_time}] [{park_prefix.upper()}] API timed out. Skipping.")
        except Exception as e:
            print(f"[{current_time}] [{park_prefix.upper()}] Error occurred: {e}")

# Let the program execute and print out instructions.
print("Multi-Park ETL Pipeline Initialized. Kill the terminal to stop.")
print("=" * 70)

# This is where the program sleeps
# and wakes up every 15 minutes to rerun
# the API check and saves the data.
while True:
    run_pipeline()
    print("Engine resting. Waking up in 15 minutes...")
    time.sleep(900)