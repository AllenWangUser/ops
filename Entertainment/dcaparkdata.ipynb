# This script pulls data for Disneyland Park from
# thrill-data.com and saves it to a CSV file.
# This pulls data on a 15 minute interval and appends
# the new data to the the new file.

# Import Libraries
import requests
import csv
import os
import time
from datetime import datetime

# This section identifies the park and
# places the park code in the URL
park_id = "832fcd51-ea19-4e77-85c7-75d5843b127c" # Disney California Adventure Park
url = f"https://api.themeparks.wiki/v1/entity/{park_id}/live"

# This section finds the file path for the save file
# and checks if the file is existing. It then sets the 
# filepath for the CSV
save_dir = os.path.join(os.getcwd(), "data/final")
os.makedirs(save_dir, exist_ok=True)
csv_filename = os.path.join(save_dir, "dca_wait_times_final.csv")

# Checks if the file currently exists
if os.path.exists(csv_filename):
# Gets the file size to check if the file is
# empty or not.
    file_size = os.path.getsize(csv_filename)
    print(f"File Name: {csv_filename}")
    print(f"File size: {file_size} bytes")
# Prints this message if file is not found.
else:
    print("File not found in the /data/final/ folder.")

# Identify and set the current date time.
def run_pipeline():
    current_time = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    
# Prints the current time and a message to indicate the pipeline is running.
    print(f"[{current_time}] Waking up and checking API.")

# This section makes the API call and checks the response status code.
    try:
        response = requests.get(url, timeout=10)

# 200 status code is OK.
        if response.status_code == 200:
            data = response.json()
            valid_data_to_save = []

# This is if a for loop that check for ride
# status and time and return the values. 
            for ride in data.get('liveData', []):
                name = ride.get('name', 'Unknown')
                status = ride.get('status', 'UNKNOWN')
                
                if status == "OPERATING" and ride.get('queue') and ride['queue'].get('STANDBY'):
                    minutes = ride['queue']['STANDBY'].get('waitTime')
                    if minutes is not None:
                        valid_data_to_save.append([current_time, name, minutes])

# Returns this message if there are no valide data.
            if len(valid_data_to_save) == 0:
                print(f"[{current_time}] CRITICAL: Park closed or no standby data available.")
            else:
                file_exists = os.path.isfile(csv_filename)

# Accesses the file and appends the new data to 
# the end of the file and saves the file.
                with open(csv_filename, 'a', newline='', encoding='utf-8') as file:
                    writer = csv.writer(file, delimiter=';')
                    if not file_exists:
                        writer.writerow(["Timestamp", "Ride Name", "Wait Time (Minutes)"])
                    writer.writerows(valid_data_to_save)
                
# Printing status codes for current process clarity
                print(f"[{current_time}] Successfully appended {len(valid_data_to_save)} records to {csv_filename}")
        else:
            print(f"[{current_time}] Connection failed: Status code {response.status_code}")

    except requests.exceptions.Timeout:
        print(f"[{current_time}] The API timed out. Skipping.")
    except Exception as e:
        print(f"[{current_time}] Error occurred: {e}")

# --- THE AUTOMATION ENGINE ---
print("DCA ETL Pipeline Initialized. Kill the terminal to stop.")
print("=" * 70)

while True:
    run_pipeline()
    print("Engine resting. Waking up in 15 minutes...\n")
    time.sleep(900)